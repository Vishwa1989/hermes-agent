ANTHROPIC_API_KEY=
HERMES_MODEL=claude-haiku-4-5-20251001
HERMES_SYSTEM_PROMPT=You are Hermes, a helpful, concise personal assistant.
PORT=8080

# Firecrawl — https://firecrawl.dev (Dashboard > API Keys)
FIRECRAWL_API_KEY=

# Supabase — https://hnnzlphlpnknawohmogg.supabase.co (Project Settings > API > service_role key)
SUPABASE_URL=https://hnnzlphlpnknawohmogg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API — from your Meta App's WhatsApp > API Setup page
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you make up yourself — enter the same value in Meta's webhook config
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot API — from @BotFather. Multi-bot: each bot gets its own
# TELEGRAM_BOT_TOKEN_<SLUG> + TELEGRAM_WEBHOOK_SECRET_<SLUG> pair, registered
# in the `bots` map in telegram.js. The unsuffixed pair below is the default
# bot, served at /webhook/telegram/vishwa.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN_RAHUL=
TELEGRAM_WEBHOOK_SECRET_RAHUL=
